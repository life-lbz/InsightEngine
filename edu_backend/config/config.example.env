APP_ENV=dev
ACTIVE_SCENARIO_ID=education_qa
DEFAULT_COURSE_ID=default_course
DEFAULT_KB_VERSION=kb_manual_v1
API_PORT=8000
CORS_ALLOW_ORIGINS=["*"]

MYSQL_HOST=127.0.0.1
MYSQL_PORT=13307
MYSQL_USER=root
MYSQL_PASSWORD=root123
MYSQL_DATABASE=insight_engine
MYSQL_POOL_SIZE=20
MYSQL_MAX_OVERFLOW=10
MYSQL_POOL_RECYCLE=3600

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50
CACHE_ENABLED=false

MILVUS_URI=http://127.0.0.1:19530
MILVUS_SEARCH_TIMEOUT=3.0
MILVUS_CONNECT_RETRY=3

LLM_MODEL=deepseek-chat
LLM_FALLBACK_MODEL=deepseek-chat
PROJECT_DEEPSEEK_API_KEY=PROJECT_DEEPSEEK_API_KEY
PROJECT_DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=60.0
LLM_RETRY_COUNT=2

# 模型路径占位符：部署时覆盖为实际本地路径或 HuggingFace model_id
# EMBEDDING_MODEL_PATH=
# RERANKER_MODEL_PATH=
# INTENT_BERT_MODEL_PATH=
EMBEDDING_BATCH_SIZE=64
RERANK_BATCH_SIZE=32

SEARCH_CACHE_TTL=300
ANSWER_CACHE_TTL=3600

ADMIN_API_TOKEN=replace-with-random-token
JWT_SECRET_KEY=replace-with-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

API_RATE_LIMIT_PER_MINUTE=300
API_RATE_LIMIT_READ_MULTIPLIER=3
ADMIN_RATE_LIMIT_PER_MINUTE=60

MAX_HISTORY_TOKENS=2000
HALLUCINATION_MAX_UNSUPPORTED_CLAIMS=2

MIN_CHUNK_CHARS=20
CHUNK_DEDUP_JACCARD_THRESHOLD=0.85
COLLECTION_ARCHIVE_AFTER_DAYS=7
COLLECTION_DELETE_AFTER_DAYS=30